\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{e_document_layout}[2026/07/14 v1.1 Standard-document layout and navigation]

\RequirePackage{e_kernel}
\RequirePackage{e_visual}
\RequirePackage{e_tables}
\RequirePackage[unicode]{hyperref}
\RequirePackage{bookmark}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec,titletoc,etoc}
\RequirePackage{enumitem}

% Visual line breaks in titles/headings become ordinary spaces in bookmarks
% and PDF metadata.  Without this rule, the frontmatter metadata bridge passes
% a perfectly valid title such as \title{First \\ Second} to hyperref, which
% drops the command but emits "Token not allowed in a PDF string".
\pdfstringdefDisableCommands{%
  \def\\{ }%
}

\input{sty_components/c110_layout.tex}
\input{sty_components/c130_toc.tex}

\hypersetup{
  colorlinks=true,
  linkcolor=mylinkcolor,
  citecolor=mycitecolor,
  urlcolor=mylinkcolor,
  anchorcolor=mylinkcolor,
  filecolor=mylinkcolor,
  linktoc=page,
}

% The [12pt] heading-size policy that once lived here has moved to the
% feature e_style/sty_features/e_heading_scale.sty (classes select it),
% so this component no longer reads class-option state or references a
% title feature by name.

\endinput
