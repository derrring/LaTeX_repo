% ===================================================================
% c112_langfamily.sty — per-script font families honoured by luatexja
%
% Provides \newlangfamily for declaring inline font switches tied to
% a tag (e.g., zh, ja, ar, he). Each call creates:
%
%     \<tag>font    -- NFSS font family switch (grouped scope)
%     \text<tag>{x} -- typeset x in the tag font, grouped
%
% Implementation note: this package uses \newjfontfamily from
% luatexja-fontspec, NOT plain \newfontfamily. The reason is that
% luatexja's jachar reroute happens inside its pre_linebreak_filter
% and overrides any font selected via plain \newfontfamily for
% codepoints in jachar ranges (CJK Unified Ideographs etc.). Only
% font families declared via \newjfontfamily are honoured by the
% reroute. This package is therefore CJK-aware by construction;
% tags like \textzh and \textja do what their name suggests.
%
% Typical usage in a document preamble:
%
%     \usepackage{c112_langfamily}
%     \newlangfamily{zh}{Source Han Serif SC}   % defines \textzh{...}
%     % \textja is unnecessary unless overriding the class default
%     % (which is configured via \setmainjfont in e_cjk).
%
% Note on coverage/fallback: fontspec/luatexja-fontspec has no true
% coverage-based fallback -- AltFont is a range override, not "use only if
% the primary lacks the glyph" -- so there is no implicit safety net. The
% e_cjk fast path (Source Han / Harano Aji) covers CJK Unified + Ext-A,
% which is effectively all real-world CJK; supplementary-plane ideographs
% (Ext-B..H) are NOT covered by those families. Rare-glyph coverage requires
% the explicit opt-in AltFont ladder (HanaMinB/Jigmo/Unifont) installed by
% \eEnableCJKExtensionFonts in e_cjk, which is wired into BOTH the main
% (mincho) and sans (gothic) jfonts. A \newlangfamily declared here shares
% none of that ladder unless it is itself given an AltFont range.
%
% CJK line-breaking and the jachar default font are configured in
% e_cjk (luatexja[pass] + luatexja-fontspec + \setmainjfont).
% For full Japanese layout (ruby, kenten emphasis) use c113_cjk_engine.
% ===================================================================

\ProvidesPackage{c112_langfamily}[2026/04/14 Per-script font families honoured by luatexja]
\RequirePackage{luatexja-fontspec}

% \newlangfamily{tag}{font name}
% Creates \<tag>font (NFSS family switch) and \text<tag>{x} (grouped inline
% switch). The inline switch is \text<tag>, NOT bare \<tag>: luatexja reserves
% \zh/\zw as length primitives, so \zh{...} would clobber a primitive and break
% ruby. Redefinition is silent (\def) so \newlangfamily{zh} cleanly overrides
% the no-op \textzh default that e_cjk installs.
\newcommand{\newlangfamily}[2]{%
    \expandafter\newjfontfamily\csname #1font\endcsname{#2}%
    \expandafter\def\csname text#1\endcsname##1{{\csname #1font\endcsname ##1}}%
}

\endinput
