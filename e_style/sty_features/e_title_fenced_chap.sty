% =================================================================
% e_title_fenced_chap.sty
% Chapter title style with horizontal fenced rules above and below.
% =================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{e_title_fenced_chap}%
  [2026/07/12 v1.4 Stable fenced chapter geometry]

% Direct dependency for \titleformat and \titlespacing.
\RequirePackage{titlesec}

% Shared \part formatting (Roman numerals, centered, colored)
\RequirePackage{e_title_part}

% Shared atomic fence-box geometry (rules + symmetric gaps).
\RequirePackage{e_title_fenced_core}

% =================================================================
% Chapter title (numbered)
% =================================================================

\makeatletter

% Public font hook. The 1ex internal gaps below are evaluated after this hook,
% so changing the title size also scales the fence-to-text separation.
\newcommand{\eFencedChapterFont}{\normalfont\bfseries\large}

% Keep external rhythm tied to the final body baseline while the fence's own
% geometry stays single-spaced. titlesec's after-skip is followed by paragraph
% glue, so subtract \parskip once to retain the intended net separation.
\newskip\e@fenced@chapter@afterskip
\newcommand{\e@fenced@chapter@syncspacing}{%
  \begingroup
    \normalfont\normalsize
    \skip@=.7\baselineskip plus .07\baselineskip\relax
    \advance\skip@ by -\parskip
    \global\e@fenced@chapter@afterskip=\skip@
  \endgroup
}
\AddToHook{begindocument/end}{\e@fenced@chapter@syncspacing}

% The atomic fence-box geometry is shared with the section style
% (e_title_fenced_core.sty); this level only supplies its font hook.
% Body text after the title retains the document's own paragraph spacing.
\newcommand{\e@fenced@chapter@box}[1]{\e@fenced@box{\eFencedChapterFont}{#1}}

\newcommand{\e@fenced@chapter@numbered}[1]{%
  \e@fenced@chapter@box{\thechapter\quad\MakeUppercase{#1}}}

\newcommand{\e@fenced@chapter@numberless}[1]{%
  \@ifundefined{phantomsection}{}{\phantomsection}%
  \e@fenced@chapter@box{\MakeUppercase{#1}}}

\titleformat{\chapter}[block]
  {\normalfont\parskip=0pt\relax\nostruts}
  {}{0pt}
  {\e@fenced@chapter@numbered}

% Chapter title (unnumbered, starred)
\titleformat{name=\chapter,numberless}[block]
  {\normalfont\parskip=0pt\relax\nostruts}
  {}{0pt}
  {\e@fenced@chapter@numberless}

% Chapters already start on a fresh page, so no additional space is needed
% above. Measure the compact body separation from the lower fence, not from the
% title glyphs inside it. This declaration affects \chapter only, leaving
% section and subsection spacing at class defaults.
\titlespacing*{\chapter}{0pt}{0pt}{\e@fenced@chapter@afterskip}

\makeatother
\endinput
