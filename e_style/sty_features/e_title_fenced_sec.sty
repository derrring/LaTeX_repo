\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{e_title_fenced_sec}%
  [2026/07/12 v1.4 Stable fenced section geometry]

% Direct dependency for \titleformat and \titlespacing.
\RequirePackage{titlesec}

% ====================================================================
% == Fenced Section Title Style ==
% ====================================================================
% Creates section titles with horizontal rules above and below.
% Uses titlesec's \titleformat command. The complete fence is built in
% one vbox so body-level \baselinestretch and \parskip changes cannot alter
% the title's internal geometry.
%
% DIMENSION CONSTANTS:
%   - Rule thickness: 1.5pt provides visible weight without being heavy.
%   - Title gap: 1ex, measured in the selected heading font, on both sides.
%   - External rhythm: treat the complete fence as the heading boundary. Its
%     visible before/after distances follow ordinary section-heading rhythm;
%     baseline-relative units follow the document's body line spreading.
% ====================================================================

\makeatletter

% Public font hook. The 1ex internal gaps below are evaluated after this hook,
% so changing the title size also scales the fence-to-text separation.
\newcommand{\eFencedSectionFont}{\normalfont\bfseries\large}

% Keep external rhythm tied to the final body baseline while the fence's own
% geometry stays single-spaced. titlesec's after-skip is followed by paragraph
% glue, so subtract \parskip once to retain the intended net separation.
\newskip\e@fenced@section@beforeskip
\newskip\e@fenced@section@afterskip
\newcommand{\e@fenced@section@syncspacing}{%
  \begingroup
    \normalfont\normalsize
    \skip@=1.56\baselineskip
      plus .21\baselineskip minus .1\baselineskip\relax
    \global\e@fenced@section@beforeskip=\skip@
    \skip@=.7\baselineskip plus .07\baselineskip\relax
    \advance\skip@ by -\parskip
    \global\e@fenced@section@afterskip=\skip@
  \endgroup
}
\AddToHook{begindocument/end}{\e@fenced@section@syncspacing}

% Keep the heading single-spaced and remove paragraph glue locally. The
% nested vbox makes the visible gap exactly 1ex from each glyph box to its
% rule, including for wrapped titles, and keeps the whole fence atomic.
\newcommand{\e@fenced@section@box}[1]{%
  \begingroup
    \linespread{1}\selectfont
    \eFencedSectionFont
    \parindent=0pt\relax
    \parskip=0pt\relax
    \noindent
    \vbox{%
      \hsize=\linewidth
      \hrule height 1.5pt
      \kern 1ex
      \vbox{%
        \hsize=\linewidth
        \parindent=0pt\relax
        \parskip=0pt\relax
        \emergencystretch=2em\relax
        \raggedright
        \noindent#1\par
      }%
      \kern 1ex
      \hrule height 1.5pt
    }%
  \endgroup
}

\newcommand{\e@fenced@section@numbered}[1]{%
  \e@fenced@section@box{\thesection\quad\MakeUppercase{#1}}}

\newcommand{\e@fenced@section@numberless}[1]{%
  \@ifundefined{phantomsection}{}{\phantomsection}%
  \e@fenced@section@box{\MakeUppercase{#1}}}

% Numbered sections
\titleformat{\section}[block]
{\normalfont\parskip=0pt\relax\nostruts}
{}{0pt}
{\e@fenced@section@numbered}

% Unnumbered (starred) sections
\titleformat{name=\section,numberless}[block]
{\normalfont\parskip=0pt\relax\nostruts}
{}{0pt}
{\e@fenced@section@numberless}

% Section spacing: {left}{before}{after}. The old 0pt/20pt pair left only the
% ambient paragraph glue above the fence while adding a large dedicated gap
% below it. Match an ordinary section's visible rhythm at the outer fence edges,
% with more space above than below. This declaration affects \section only;
% lower heading levels retain their class defaults.
\titlespacing*{\section}{0pt}
  {\e@fenced@section@beforeskip}
  {\e@fenced@section@afterskip}

\makeatother
\endinput
