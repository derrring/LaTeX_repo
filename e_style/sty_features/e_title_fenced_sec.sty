\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{e_title_fenced_sec}%
  [2026/04/12 v1.1 Fenced section titles]

% ====================================================================
% == Fenced Section Title Style ==
% ====================================================================
% Creates section titles with horizontal rules above and below.
% Uses titlesec's \titleformat command.
%
% DIMENSION CONSTANTS:
%   - Rule thickness: 1.5pt provides visible weight without being heavy.
%   - Title gap: 1ex provides breathing room between rule and text.
%   - After spacing: 20pt between section title block and body text.
% ====================================================================

% Numbered sections
% \\* and \nopagebreak glue top-rule + body + bottom-rule together as an
% atomic unit, so the fence cannot split across a page break.
% Note: in titlesec [after-code], a bare `\nopagebreak[4]` confuses the
% bracket parser (the [4] is read as end-of-after-code). Use the
% optional-argument-less form, which already defaults to penalty -10000.
\titleformat{\section}[block]
{\normalfont\bfseries\large}
{}{0pt}
{\noindent\rule{\dimexpr\linewidth-2.08pt\relax}{1.5pt}\\*[1ex]\nopagebreak\thesection\quad\MakeUppercase}
[\nopagebreak\noindent\rule{\dimexpr\linewidth-2.08pt\relax}{1.5pt}]

% Unnumbered (starred) sections
\titleformat{name=\section,numberless}[block]
{\normalfont\bfseries\large}
{}{0pt}
{\noindent\rule{\dimexpr\linewidth-2.08pt\relax}{1.5pt}\\*[1ex]\nopagebreak\MakeUppercase}
[\nopagebreak\noindent\rule{\dimexpr\linewidth-2.08pt\relax}{1.5pt}]

% Section spacing: {left}{before}{after}
\titlespacing*{\section}{0pt}{0pt}{20pt}
\endinput
