% =================================================================
% beamerthemeMyEspresso.sty
% Main theme file for MyEspresso Beamer theme.
% Based on the Amurmaple theme by Maxime CHUPIN.
% =================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeMyEspresso}[2026/04/11 v2.0 MyEspresso Beamer Theme]

\mode<presentation>

\RequirePackage{e_profile_beamer}
\setbeamercovered{dynamic}

% =================================================================
% Theme options
% =================================================================

% -- Display toggles (positive naming: true = feature shown) --
\newif\ifbeamer@me@showgauge
\beamer@me@showgaugetrue
\DeclareOptionBeamer{nogauge}{\beamer@me@showgaugefalse}

\newif\ifbeamer@me@showmail
\beamer@me@showmailtrue
\DeclareOptionBeamer{nomail}{\beamer@me@showmailfalse}

% -- Visual options --
\newif\ifbeamer@me@delaunay
\beamer@me@delaunayfalse
% The mesh is re-drawn on every build. \time is minutes since midnight, so it
% is stable within a minute -- the passes of one latexmk run normally agree,
% while separate builds differ. Pin it with [randomseed=<int>] when a build
% has to be byte-reproducible (PDF diffing, pixel comparison).
\def\myespresso@randomseed{\the\time}
\def\myespresso@meshpoints{44}
\DeclareOptionBeamer{delaunay}{\beamer@me@delaunaytrue}
\DeclareOptionBeamer{randomseed}{\def\myespresso@randomseed{#1}}
\DeclareOptionBeamer{randomize}{}% default behaviour; kept for compatibility
\DeclareOptionBeamer{meshpoints}{\def\myespresso@meshpoints{#1}}
% [meshdebug] makes \myespresso@drawmesh announce the seed it actually computed.
% Off by default and silent in every ordinary build. It exists because the seed
% is otherwise unobservable from outside: a test can re-derive what the seed
% OUGHT to be and compare two overlays of it, but that measures beamer's counter
% rather than this theme, and passes unchanged when the theme is keyed on
% something else entirely -- which is how the overlay bug survived. Emitting the
% computed value is the only form of this check that can go red.
\newif\ifbeamer@me@meshdebug
\beamer@me@meshdebugfalse
\DeclareOptionBeamer{meshdebug}{\beamer@me@meshdebugtrue}

\newif\ifbeamer@me@myespressoblue
\beamer@me@myespressobluefalse
\DeclareOptionBeamer{myespressoblue}{\beamer@me@myespressobluetrue}

\newif\ifbeamer@me@myespressogreen
\beamer@me@myespressogreenfalse
\DeclareOptionBeamer{myespressogreen}{\beamer@me@myespressogreentrue}

\newif\ifbeamer@me@myespressoblack
\beamer@me@myespressoblackfalse
\DeclareOptionBeamer{myespressoblack}{\beamer@me@myespressoblacktrue}

\newif\ifbeamer@me@sidebar
\beamer@me@sidebarfalse
\def\myespresso@sidebarwidth{60pt}
\DeclareOptionBeamer{sidebarwidth}{\def\myespresso@sidebarwidth{#1}}
\DeclareOptionBeamer{sidebar}{\beamer@me@sidebartrue}

\newif\ifbeamer@me@toplogo
\beamer@me@toplogofalse
\DeclareOptionBeamer{toplogo}{\beamer@me@toplogotrue}

\newif\ifbeamer@me@leftframetitle
\beamer@me@leftframetitlefalse
\DeclareOptionBeamer{leftframetitle}{\beamer@me@leftframetitletrue}

\newif\ifbeamer@me@rule
\beamer@me@rulefalse
\def\myespresso@rulecolor{black}
\DeclareOptionBeamer{rule}{\beamer@me@ruletrue}
\DeclareOptionBeamer{rulecolor}{\def\myespresso@rulecolor{#1}}

\ProcessOptionsBeamer

% =================================================================
% Conditional packages
% =================================================================

\RequirePackage{fontawesome5}
\RequirePackage{iftex}
% Used directly by this theme, so required here rather than inherited from
% e_profile_beamer's package list: multicols in \sepframe's two-column TOC,
% \resizebox in the mesh node and the rotated bar title.
\RequirePackage{multicol}
\RequirePackage{graphicx}

\ifbeamer@me@delaunay
  \ifLuaTeX
    % The triangulation is ours (myespresso-delaunay.lua): Bowyer-Watson in
    % Lua, verified against scipy.spatial.Delaunay. It replaces luamesh,
    % whose MetaPost back end -- its default -- cannot compile under beamer
    % with current luamplib, and which has had no release since 2022.
    %
    % It also uses its own generator rather than l3's, so the theme no longer
    % makes a global \sys_gset_rand_seed:n assignment to the document's
    % random state on behalf of documents that never asked for a mesh.
    \directlua{ MyEspressoMesh = require("myespresso-delaunay") }
  \else
    \PackageError{beamerthemeMyEspresso}%
      {The 'delaunay' option requires LuaLaTeX}%
      {Compile with lualatex instead of pdflatex or xelatex.}
  \fi
\fi

% =================================================================
% TOC depth counter for \sepframe
% =================================================================

\newcounter{myespressotoc}
\setcounter{myespressotoc}{1}
\newcounter{myespresso@oldtoc}

% =================================================================
% Metadata commands (global tl — used across group boundaries)
% =================================================================

\ExplSyntaxOn

\tl_new:N \g_myespresso_mail_tl
\tl_new:N \g_myespresso_webpage_tl
\tl_new:N \g_myespresso_collab_tl

\NewDocumentCommand { \mail } { m }
  { \tl_gset:Nn \g_myespresso_mail_tl { #1 } }

\NewDocumentCommand { \webpage } { m }
  { \tl_gset:Nn \g_myespresso_webpage_tl { #1 } }

\NewDocumentCommand { \collaboration } { m }
  { \tl_gset:Nn \g_myespresso_collab_tl { #1 } }

\NewDocumentCommand { \myespresso@printmail } { }
  {
    \tl_if_empty:NF \g_myespresso_mail_tl
      { \tl_use:N \g_myespresso_mail_tl }
  }

\ExplSyntaxOff

% =================================================================
% Load sub-themes
% =================================================================

\usecolortheme{MyEspresso}
\usefonttheme{MyEspresso}
\useinnertheme{MyEspresso}
\useoutertheme{MyEspresso}

% =================================================================
% Progress gauge
% =================================================================

\newlength{\gauge@progress}
\NewDocumentCommand{\myespresso@gauge}{o}{%
  \def\myespresso@gaugewidth{40pt}%
  \IfNoValueF{#1}{\def\myespresso@gaugewidth{#1}}%
  \setlength{\gauge@progress}{%
    (\myespresso@gaugewidth-2pt)*\insertframenumber/\insertmainframenumber}%
  \begin{tikzpicture}[x=0.7cm,y=0.7cm]%
    \draw[color=white]
      (0pt,-2pt) -- (\myespresso@gaugewidth,-2pt) --
      (\myespresso@gaugewidth,4pt) -- (0pt,4pt) -- cycle;%
    \fill[color=white]
      (1pt,-1pt) -- (\the\gauge@progress+1pt,-1pt) --
      (\the\gauge@progress+1pt,3pt) -- (1pt,3pt) -- cycle;%
  \end{tikzpicture}%
}

% =================================================================
% Delaunay mesh generation (LuaLaTeX only)
% =================================================================

% Point generation now lives in the Lua module too, so there is no
% \myespresso@buildpoints any more: one seed in, edge list out.
%
% Everything except the bare call stays in the .lua file on purpose. Inside
% \directlua the argument is read by TeX first, so `#' is a parameter
% character and `\n' is an undefined control sequence -- both silently
% mangle Lua source. A call with only digits, letters and commas has no such
% edge.
% Each cover gets its own mesh. The seed is stateless -- the same seed always
% gives the same triangulation -- so without a per-cover term the title page,
% every \sepframe and the closing frame would all carry the identical
% ornament. luamesh got this for free by advancing a shared RNG per call;
% here the variation has to be asked for.
%
% That term is the frame's START PAGE, NOT a counter this macro advances and
% not the frame counter either. Both alternatives fail, in opposite directions,
% and each one's failure is invisible from the other's test:
%
%   - A counter advanced here steps once per *typesetting*, and beamer typesets
%     a frame body once per overlay slide. A cover carrying \pause then redraws
%     a different triangulation on each of its slides and the field jumps as the
%     presenter steps through it.
%   - \value{framenumber} (and \insertframenumber) do not collide across
%     overlays, but they have not stepped yet when a cover draws: measured at
%     this call site, a title page and the \sepframe that follows it both report
%     1, so two adjacent covers shared one mesh.
%
% \insertframestartpage is the page the current frame began on. It is constant
% across that frame's overlays by construction and distinct between frames.
% Measured at this call site over title page + two \sepframes: framenumber gives
% 1,1,2 and startpage gives 1,2,4.
%
% The stride is 1440 because that is the range of \time (minutes in a day),
% which makes (time, page) -> seed injective: |time difference| <= 1439 and page
% numbers differ by at least 1, so no two (time, page) pairs can land on the same
% seed. Below that they do --
% measured at stride 1, two builds one minute apart share 2 of 3 covers, the
% ornaments merely shifting along by one frame.
%
% Nothing here wants a "nice" multiplier. Adjacent seeds already decorrelate
% as thoroughly as distant ones in this LCG (mean nearest-neighbour distance
% between point sets: 0.624 at seed gap 1, 0.638 at gap 100000), so only the
% magnitude matters, not the number.
\newcommand\myespresso@drawmesh{%
  \ifbeamer@me@meshdebug
    \typeout{E-MESH-SEED=\the\numexpr\myespresso@randomseed
                          + 1440 * \insertframestartpage\relax}%
  \fi
  \begin{tikzpicture}[x=1cm,y=1cm,color=structure!15,line width=0.35pt]
    \directlua{MyEspressoMesh.emit_tikz{seed=\myespresso@randomseed
                                             + 1440 * \insertframestartpage,
                                        n=\myespresso@meshpoints,
                                        width=16, height=4.5}}
  \end{tikzpicture}}

\ExplSyntaxOn
\NewExpandableDocumentCommand { \myespresso@buildmesh } { }
  {
    \node [anchor=north~west]
      at ([xshift=-50pt,yshift=30pt]current~page.north~west)
      {
        \resizebox{1.5\paperwidth}{0.8\paperheight}
          { \myespresso@drawmesh }
      };
  }
\ExplSyntaxOff

% Single entry point for the four cover-like frames that may carry a mesh
% (title page, section page, \sepframe, \thanksframe). The option and engine
% guards live here only, so changing either is one edit rather than four.
\newcommand\myespresso@maybemesh{%
  \ifbeamer@me@delaunay
    \ifLuaTeX
      \myespresso@buildmesh
    \fi
  \fi}

% =================================================================
% \framesection — in-slide section heading
% =================================================================

% Styled through beamer keys like every other element: override with
% \setbeamerfont{framesection} / \setbeamercolor{framesection}. Defaults
% (\large\bfseries, structure) are set in the font and colour themes and
% reproduce the previous hardcoded appearance exactly.
\ExplSyntaxOn
\NewDocumentCommand { \framesection } { m }
  {
    \medskip
    \noindent
    { \usebeamerfont{framesection} \usebeamercolor[fg]{framesection} #1 }
    \par\vspace*{-0.2cm}
    \hspace*{-\c_myespresso_margin}
    { \usebeamercolor[fg]{framesection} \rule{0.4\paperwidth}{2pt} }
    \par\smallskip
  }
\ExplSyntaxOff

% =================================================================
% \sepframe — section separator with TOC
% =================================================================

\ExplSyntaxOn
\tl_new:N \l__myespresso_sepframe_title_tl
\tl_new:N \l__myespresso_sepframe_image_tl
\keys_define:nn { myespresso/sepframe }
  {
    title .tl_set:N = \l__myespresso_sepframe_title_tl ,
    image .tl_set:N = \l__myespresso_sepframe_image_tl ,
  }

\NewDocumentCommand { \sepframe } { o }
  {
    \tl_clear:N \l__myespresso_sepframe_title_tl
    \tl_clear:N \l__myespresso_sepframe_image_tl
    \IfNoValueF { #1 }
      { \keys_set:nn { myespresso/sepframe } { #1 } }
    \begingroup
    \setcounter{myespresso@oldtoc}{\value{tocdepth}}
    \setbeamercolor{section~in~toc}{fg=white}
    \tl_if_empty:NTF \l__myespresso_sepframe_title_tl
      { \def\myespresso@septitle{\secname} }
      { \def\myespresso@septitle{\l__myespresso_sepframe_title_tl} }
    \setbeamertemplate{background}{}
    \setbeamertemplate{navigation~symbols}{}
    \setbeamercolor{background~canvas}{bg=white}
    \begin{frame}[noframenumbering,plain]
      \begin{tikzpicture}[remember~picture,overlay]
        \myespresso@maybemesh
        \fill [structure]
          ([yshift=15pt]current~page.west)
          rectangle
          (current~page.south~east);
        \ifbeamer@me@rule
          \fill [MyEspresso@rule]
            ([yshift=15pt]current~page.west)
            rectangle
            ([yshift=10pt]current~page.east);
        \fi
        \node [anchor=east, text~width=0.7\paperwidth,
               font=\huge\bfseries, align=right, inner~sep=0pt]
          at ([yshift=-50pt,xshift=-25pt]current~page.north~east)
          (section)
          { \textcolor{structure}{\myespresso@septitle} };
        \node []
          at ([yshift=-40pt]current~page.center)
          (toc)
          {
            \color{white}
            \begin{minipage}{0.9\paperwidth}
              \begin{multicols}{2}
                \hypersetup{linkcolor=white}
                \setcounter{tocdepth}{\themyespressotoc}
                \tableofcontents
              \end{multicols}
            \end{minipage}
          };
        \tl_if_empty:NF \l__myespresso_sepframe_image_tl
          {
            \node [anchor=south~west]
              at ([yshift=20pt]current~page.west)
              (logo)
              {
                \parbox[t]{.19\paperwidth}
                  {
                    \raggedleft
                    \usebeamercolor[fg]{titlegraphic}
                    \l__myespresso_sepframe_image_tl
                  }
              };
          }
      \end{tikzpicture}
      \setcounter{tocdepth}{\value{myespresso@oldtoc}}
    \end{frame}
    \endgroup
  }
\ExplSyntaxOff

% =================================================================
% \thanksframe — closing slide
% =================================================================

\NewDocumentCommand{\thanksframe}{o m}{%
  \begingroup
  \setbeamertemplate{background}{}
  \setbeamertemplate{navigation symbols}{}
  \setbeamercolor{background canvas}{bg=white}
  \IfNoValueTF{#1}{%
    \def\myespresso@finalgraphic{\inserttitlegraphic}%
  }{%
    \def\myespresso@finalgraphic{#1}%
  }%
  \begin{frame}[noframenumbering,plain]
    \begin{tikzpicture}[remember picture,overlay]
      \myespresso@maybemesh
      \fill[structure]
        ([yshift=15pt]current page.west)
        rectangle
        (current page.south east);
      \ifbeamer@me@rule
        \fill[MyEspresso@rule]
          ([yshift=15pt]current page.west)
          rectangle
          ([yshift=10pt]current page.east);
      \fi
      % Anchor / position / width matched to the title-page node in
      % beamerinnerthemeMyEspresso.sty so the front and back covers
      % share the same visual layout. yshift=-15pt places the top of
      % the closing message 30pt below the split rule line (same
      % breathing room as the front title).
      \node[anchor=north east, inner sep=0pt]
        at ([yshift=-4pt,xshift=-20pt]current page.east)
        (section)
        {\usebeamerfont{title}%
         \parbox[t]{0.9\paperwidth}{\raggedleft
           \color{white}\vspace*{-\topskip}%
           #2}};
      \node[anchor=south west]
        at ([yshift=20pt]current page.west)
        (logo)
        {\parbox[t]{.19\paperwidth}{\raggedleft
          \usebeamercolor[fg]{titlegraphic}\myespresso@finalgraphic}};
    \end{tikzpicture}
  \end{frame}
  \endgroup
}

% =================================================================
% \boxalert — highlighted inline text
% =================================================================

\newenvironment{boxalertenv}{\begin{altenv}%
      {\usebeamertemplate{alerted text begin}%
       \usebeamercolor[fg]{alerted text}%
       \usebeamerfont{alerted text}\colorbox{bg}}
      {\usebeamertemplate{alerted text end}}{\color{.}}{}}{\end{altenv}}

\newcommand<>{\boxalert}[1]{{%
  \begin{boxalertenv}#2{#1}\end{boxalertenv}%
}}

% =================================================================
% Hyperlink colors
% =================================================================

\hypersetup{
    colorlinks=true,
    linkcolor=structure.fg!60,
    citecolor=alerted text.fg!60,
    urlcolor=structure.fg!60,
    anchorcolor=structure.fg!60,
    filecolor=structure.fg!60,
    linktoc=page,
}

\mode<all>
\endinput
